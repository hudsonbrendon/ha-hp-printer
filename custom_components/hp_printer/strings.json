  "services": {
    "scan": {
      "name": "Scan",
      "description": "Scans a document and saves it to the media folder. Returns the file path.",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer to scan with." },
        "resolution": { "name": "Resolution", "description": "Resolution in dpi. Defaults to the configured scan resolution." },
        "color_mode": { "name": "Color mode", "description": "Color, grayscale or black and white." },
        "format": { "name": "Format", "description": "PDF or JPEG." },
        "source": { "name": "Source", "description": "Flatbed glass or document feeder." },
        "filename": { "name": "File name", "description": "Base name of the file (without extension). Defaults to a timestamp." }
      }
    },
    "print_file": {
      "name": "Print file",
      "description": "Prints a file from an allowed directory over IPP. JPEG works on every HP printer; PDF only on printers that list it as a supported format.",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer to print on." },
        "path": { "name": "Path", "description": "Absolute path of the file (must be inside allowlist_external_dirs or the media folder)." },
        "format": { "name": "Document format", "description": "MIME type. Guessed from the extension when omitted." },
        "copies": { "name": "Copies", "description": "Number of copies." }
      }
    },
    "print_report": {
      "name": "Print report",
      "description": "Prints one of the printer's built-in pages (status report, network summary, print quality diagnostic...) or runs a cleaning page.",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer." },
        "page": { "name": "Page", "description": "Which internal page to print." }
      }
    },
    "identify": {
      "name": "Locate printer",
      "description": "Flashes the printer's display so you can find it.",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer." }
      }
    },
    "cancel_job": {
      "name": "Cancel job",
      "description": "Cancels a print job (the current one when no id is given).",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer." },
        "job_id": { "name": "Job id", "description": "IPP job id. Omit to cancel the job being printed." }
      }
    },
    "clean_cartridges": {
      "name": "Clean cartridges",
      "description": "Runs the cartridge cleaning routine (prints a page).",
      "fields": {
        "device_id": { "name": "Printer", "description": "The HP printer." },
        "level": { "name": "Level", "description": "1 = light, 3 = deep cleaning." }
      }
    }
  },
  "exceptions": {
    "cannot_connect": { "message": "Could not reach the printer at {host}: {error}" },
    "not_supported": { "message": "The device at {host} does not speak HP LEDM or CDM." },
    "update_failed": { "message": "Updating printer data failed: {error}" },
    "password_required": { "message": "This setting needs the printer admin password. Add it under Reconfigure." },
    "invalid_auth": { "message": "The printer rejected the admin password." },
    "not_supported_action": { "message": "This printer does not support that action: {error}" },
    "communication_error": { "message": "Communication with the printer failed: {error}" },
    "scan_failed": { "message": "Scan failed: {error}" },
    "scan_in_progress": { "message": "A scan is already in progress." },
    "no_active_job": { "message": "There is no active print job to cancel." },
    "device_not_found": { "message": "No HP printer with device id {device_id}." },
    "entry_not_loaded": { "message": "The HP printer {device_id} is not loaded." },
    "no_scanner": { "message": "This printer has no scanner." },
    "path_not_allowed": { "message": "{path} is not inside an allowed directory." },
    "file_not_found": { "message": "{path} does not exist." }
  }
}
