{
  "title": "HP Printer",
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "Connect to your HP printer",
        "description": "Status, supplies and scanning work without a password. The EWS admin password (user admin, often the PIN printed inside the cartridge door) unlocks settings such as sleep timeout and network services.",
        "data": {
          "host": "Host",
          "password": "Admin password"
        },
        "data_description": {
          "host": "IP address or hostname of the printer on your network.",
          "password": "Optional. Needed only to change printer settings."
        }
      },
      "discovery_confirm": {
        "title": "HP printer found",
        "description": "Add {name} at {host}? You can enter the EWS admin password now or later from Reconfigure.",
        "data": {
          "password": "Admin password"
        },
        "data_description": {
          "password": "Optional. Needed only to change printer settings."
        }
      },
      "reauth_confirm": {
        "title": "Update the admin password",
        "description": "{name} rejected the stored admin password. Enter the current one (leave empty to stop writing settings).",
        "data": {
          "password": "Admin password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure the printer",
        "data": {
          "host": "Host",
          "password": "Admin password"
        },
        "data_description": {
          "host": "IP address or hostname of the printer on your network.",
          "password": "Optional. Needed only to change printer settings."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "not_supported": "The device answered but does not speak HP LEDM or CDM. Is it an HP printer?",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Device is already configured",
      "already_in_progress": "Configuration flow is already in progress",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful",
      "wrong_device": "That address belongs to a different printer.",
      "cannot_connect": "Failed to connect",
      "not_supported": "The device does not speak HP LEDM or CDM.",
      "unknown": "Unexpected error"
    }
  },
  "options": {
